{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["00_Global/AGENTS.md"],
  "mcp": {
    "{{PROJECT_NAME}}": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        ".",
        "scripts/mcp_server.py"
      ]
    }
  },
  "agent": {
    "plan": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "build": {
      "model": "deepseek/deepseek-v4-flash"
    }
  }
}
